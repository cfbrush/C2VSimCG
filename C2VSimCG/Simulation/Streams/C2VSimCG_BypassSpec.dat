C*******************************************************************************
C                          File Description
C
C  This data file contains the specification data for stream bypasses.
C
C*******************************************************************************
C
C       Rating Flow
C   ID  Table  Values Description
C  ---- ------ ------ -----------
C    1           x    M&T Flood Relief Structure spill to Butte Basin
C    2           x    3Bs Flood Relief Structure spill to Butte Basin
C    3           x    Goose Lake Flood Relief Structure to Butte Basin
C    4           x    Moulton Weir spill to Butte Basin                                                 
C    5           x    Colusa Weir spill to Butte Basin                                                  
C    6           x    Tisdale Weir near Grimes                                                  
C    7           x    Fremont Weir spill to Yolo Bypass                                                 
C    8           x    Sacramento Weir spill to Yolo Bypass                                                      
C    9           x    Knights Landing Ridge Cut flood flow to Yolo Bypass                                                       
C   10     x          Reset of Cache Creek at Caypay Dam
C   11           x    Kings River to S Fork Kings River                                                 
C   12     x          San Joaquin River to Chowchilla Bypass                                                    
C   13     x          Chowchilla River to Eastside Bypass                                                       
C   14     x          Deadman's Creek to Eastside Bypass                                                        
C   15     x          Bear Creek to Eastside Bypass                                                     
C   16     x          End of Kaweah River to be spread in Kaweah River Fan as recharge                                                  
C   17     x          End of Tule River to be spread in Tule River Fan as recharge                                                      
C   18     x          Kern River Flood Channel
C   19           x    Delta Cross Channel
C   20           x    San Joaquin River to Old River near Stewart Tract
C   21           x    San Joaquin River to Old River near Webb Tract
C   22           x    Sacramento River to Old River near Webb Tract
C----------------------------------------------------------------------------------
C
C                 Bypass Configuration Specifications
C
C   NBYPS   ; Number of bypasses
C   FACTX   ; Conversion factor for DIVX
C              It is used to convert only the spatial component of the unit; 
C              DO NOT include the conversion factor for time component of the unit.
C              * e.g. Unit of stream flow listed in this file   = AC-FT/MONTH
C                     Consistent unit used in simulation        = CU.FT/DAY 
C                     Enter FACTX (AC-FT/MONTH -> CU.FT/MONTH)  = 43560.0 
C                      (conversion of MONTH -> DAY is performed automatically) 
C   TUNITX  ; Time unit of stream flow.  This should be one of the units 
C              recognized by HEC-DSS that are listed in the Main Control File.  
C   FACTY   ; Conversion factor for DIVY
C              It is used to convert only the spatial component of the unit; 
C              DO NOT include the conversion factor for time component of the unit.
C              * e.g. Unit of spills listed in this file        = AC-FT/MONTH
C                     Consistent unit used in simulation        = CU.FT/DAY 
C                     Enter FACTY (AC-FT/MONTH -> CU.FT/MONTH)  = 43560.0 
C                      (conversion of MONTH -> DAY is performed automatically) 
C   TUNITY  ; Time unit of spills into the bypasses.  This should be one of the  
C              units recognized by HEC-DSS that are listed in the Main Control File.  
C
C-------------------------------------------------------------------------------
C   VALUE                       DESCRIPTION
C-------------------------------------------------------------------------------
      22                        / NDIVS
      60.0                      / FACTX       values in CFS * 60 -> CFM
      1min                      / TUNITX
      60.0                      / FACTY       values in CFS * 60 -> CFM
      1min                      / TUNITY
C----------------------------------------------------------------------------------
C
C   ID      ; Bypass identification number
C   IA      ; Stream node number where spills into bypass canal occur
C   TYPEDEST; Destination type for the bypass
C               0 = bypass goes to outside the model boundary
C               1 = bypass goes to a downstream node
C               3 = bypass goes to a lake
C   DEST    ; Destination for the bypass
C               * Note: Enter any number if TYPEDEST is set to 0
C   IDIVC   ; If positive, IDIVC is the column number in the Diversion Data File for spills into bypass
C             If negative, IDIVC is the number of points in the bypass rating table
C               * Note: A rating table cannot be specified if the bypass originates outside the model area
C   DIVRL   ; Fraction of the bypass flows assigned as recoverable loss
C   DIVNL   ; Fraction of the bypass flows assigned as non-recoverable loss
C   DIVX    ; Stream flow available at stream node IA; [L^3/T]
C               * Note: Enter only if IDIVC is less than zero
C   DIVY    ; Spills into bypass canal corresponding to DIVX; [L^3/T]
C               * Note: Enter only if IDIVC is less than zero
C   NAME    ; Name of the bypass (maximum 20 characters)
C
C----------------------------------------------------------------------------------
C      ID       IA    TYPEDEST  DEST   IDIVC   DIVRL     DIVNL   NAME
C                                              DIVX      DIVY    ( this rating table should follow if IDIVC < 0 )
C-------------------------------------------------------------------------------------------------------                                                
        1       401     1       458     439     0.0        0.0      M&T_Flood               / Bypass 1 - M&T Flood Relief Structure spill to Butte Basin
        2       402     1       458     440     0.0        0.0      3Bs_Flood               / Bypass 2 - 3Bs Flood Relief Structure spill to Butte Basin
        3       404     1       458     441     0.0        0.0      Goose_Lake_Flood        / Bypass 3 - Goose Lake Flood Relief Structure to Butte Basin
        4       407     1       458     442     0.0        0.0      Moulton_Weir            / Bypass 4 - Moulton Weir spill to Butte Basin
        5       409     1       458     443     0.0        0.0      Colusa_Weir             / Bypass 5 - Colusa Weir spill to Butte Basin
        6       430     1       464     444     0.0        0.0      Tisdale_Weir            / Bypass 6 - Tisdale Weir near Grimes
        7       498     1       528     445     0.0        0.0      Fremont_Weir            / Bypass 7 - Fremont Weir spill to Yolo Bypass
        8       503     1       529     446     0.0        0.0      Sac_Weir                / Bypass 8 - Sacramento Weir spill to Yolo Bypass
        9       446     1       528     447     0.0        0.0      KLR_to_Yolo_Bypass      / Bypass 9 - Knights Landing Ridge Cut flood flow to Yolo Bypass
