C*******************************************************************************
C                          File Description
C
C   This data file contains the parameters and data file names for the simulation
C   of root zone processes and managament of lands with rice and refuge.
C
C*******************************************************************************
C            Number of Ponded Crops and Crop Codes
C
C   NRICE    ;  Number of rice categories 
C   NREFUGE  ;  Number of refuge categories
C   CCODE    ;  Crop codes (max. 10 characters)
C               (1 to NRICE + NREFUGE)
C             * Note: First rice category codes must be listed, 
C                     then refuge category codes
C   LUFLNP   ;  File that lists the crop areas (max. 1000 characters)
C
C--------------------------------------------------------------------------------
C   VALUE                                           DESCRIPTION
C--------------------------------------------------------------------------------
 3                                                  / NRICE
 2                                                  / NREFUGE
 RICE_FL                                            / CCODE[1]
 RICE_NFL                                           / CCODE[2]
 RICE_NDC                                           / CCODE[3]
 REFUGE_SL                                          / CCODE[4]
 REFUGE_PR                                          / CCODE[5]
 RootZone\C2VSimCG_PondedCrop_Area.dat              / LUFLP
C*******************************************************************************
C                      Water Budget Output Files
C
C   NBCROP   ;  Number of ponded crops for water budget output
C                * Enter 0 if crop specific budget output is not required
C   BCCODE   ;  Crop codes for which water budget output is required
C                (1 to NBCROP)
C   CLWUBUDFL;  HDF5 output file for land and water use budget at each 
C                  subregion for selected crops (max. 1000 characters)
C                * Leave blank if this output is not required
C   CRZBUDFL ;  HDF5 output file for root zone moisture budget at each
C                  subregion for selected crops (max. 1000 characters)
C                * Leave blank if this output is not required
C
C--------------------------------------------------------------------------------
C   VALUE                 DESCRIPTION
C--------------------------------------------------------------------------------
      0                                                 / NBCROP
*     RICE_FL                                           / BCCODE[1]
*     RICE_NFL                                          / BCCODE[2]
*     RICE_NDC                                          / BCCODE[3]
*     REFUGE_SL                                         / BCCODE[4]
*     REFUGE_PR                                         / BCCODE[5]
                                                        / CLWUBUDFL
                                                        / CRZBUDFL
C*******************************************************************************
C                              Rooting Depths 
C
C   FACT  ;  Conversion factor for rice and refuge root zone depths 
C   ROOT  ;  Root zone depth; [L]
C             * List the root zone depths in the same order as the crop 
C               codes (CCODE) are listed above; first for rice categories, 
C               then for refuge categories
C
C--------------------------------------------------------------------------------
C   VALUE                 DESCRIPTION
C--------------------------------------------------------------------------------
    1.0                      / FACT
C--------------------------------------------------------------------------------
C   ROOT
C--------------------------------------------------------------------------------
      2.0                 / ROOT_RI_FL
      2.0                 / ROOT_RI_NFL
      2.0                 / ROOT_RI_NDC
      2.0                 / ROOT_RF_SL
      2.0                 / ROOT_RF_PR
C*******************************************************************************
C                    Curve Numbers for Rainfall Runoff Simulation 
C
C   Enter curve numbers for each grid element and rice/refuge combination.
C
C   IE  ; Element ID (Enter 0 if following values are to be used for all element
C          and ponded crop combinations)
C   CN  ; Curve number for each ponded crop (1 to NRICE + NREFUGE)
C          * List the CN values in the same order as the crop 
C            codes (CCODE) are listed above; first for rice categories, 
C            then for refuge categories
C          * CN for rice and refuge should be entered for the type of 
C            soil and land cover during non-ponding season. During the  
C            ponding season CN=100 will be used.
C
