C*******************************************************************************
C                     Rice and Refuge Operations Input Files  
C
C   The following lists the rice and refuge operations related data files.    
C
C   PNDTHFL   ; File that lists the ponding depths for rice and refuge operations 
C                 (max. 1000 characters)
C   FLOWFL    ; File that lists rice and refuge pond operation flows (e.g. water  
C                 application depths for non-flooded decomposition of rice or   
C                 prewetting, re-use and return flow depths) (max. 1000 characters)
C
C--------------------------------------------------------------------------------
C         VALUE                                                  DESCRIPTION
C--------------------------------------------------------------------------------
        RootZone\C2VSimCG_PondedCrop_Depth.dat                   / PNDTHFL
        RootZone\C2VSimCG_PondedCrop_Operations.dat              / FLOWFL
C*******************************************************************************
C                               Ponding Depths
C
C   IE   ; Element ID (Enter 0 if following values are to be used for all element
C            and ponded crop combinations)
C   ICPD ; Ponding depth - this number corresponds to the appropriate 
C            data column in the rice/refuge ponding depth data file (PNDTHFL). 
C            List for each ponded crop (1 to NRICE + NREFUGE). 
C            * List the column pointers in the same order as the crop 
C              codes (CCODE) are listed above; first for rice categories, 
C              then for refuge categories
C
C--------------------------------------------------------------------------------
C   IE     ICPD_RI_FL  ICPD_RI_NFL  ICPD_RI_NDC  ICPD_RF_SL  ICPD_RF_PR
C--------------------------------------------------------------------------------
     0         1           2            3            4            5
C*******************************************************************************
C                        Water Application Depths
C
C   IE    ; Element ID (Enter 0 if following values are to be used for all element 
C             and ponded crop combinations)
C   ICDW  ; Water application depth for any purpose - this number corresponds 
C             to the appropriate data column in the rice/refuge flows 
C             data file (FLOWFL). List for each ponded crop (1 to NRICE + NREFUGE). 
C             * Enter 0 for crops that do not have any water application depth
C             * List the column pointers in the same order as the crop 
C               codes (CCODE) are listed above; first for rice categories, 
C               then for refuge categories
C
C--------------------------------------------------------------------------------
C   IE          ICDW_RI_FL  ICDW_RI_NFL  ICDW_RI_NDC  ICDW_RF_SL  ICDW_RF_PR
C--------------------------------------------------------------------------------
     0              0           11            0           0           0
C*******************************************************************************
C                               Return Flow Depths
C
C   IE   ;  Element ID (Enter 0 if following values are to be used for all element
C             and ponded crop combinations)
C   ICRT ;  Depth of return flow - this number corresponds to the appropriate
C             data column in the rice/refuge flows data file (FLOWFL). List for 
C             each ponded crop (1 to NRICE + NREFUGE).
C             * List the column pointers in the same order as the crop 
C               codes (CCODE) are listed above; first for rice categories, 
C               then for refuge categories
C             * Return flow for rice and refuge includes circulation depths as well 
C               as lateral subsurface flow (i.e. seepage) to return flow collection 
C               ditches.
C
C--------------------------------------------------------------------------------
C   IE     ICRT_RI_FL   ICRT_RI_NFL   ICRT_RI_NDC   ICRT_RF_SL   ICRT_RF_PR
C--------------------------------------------------------------------------------
     0          1           2            3            4            5
C*******************************************************************************
C                               Re-use Flow Depths
C
C   IE    ;  Element ID (Enter 0 if following values are to be used for all element
C              and ponded crop combinations)
C   ICRUF ; Depth of re-used water - this number corresponds to the appropriate 
C              data column in the rice/refuge flows data file (FLOWFL). List for 
C              each ponded crop (1 to NRICE + NREFUGE).
C              * List the column pointers in the same order as the crop 
C                codes (CCODE) are listed above; first for rice categories, 
C                then for refuge categories
C
C--------------------------------------------------------------------------------
C   IE     ICRUF_RI_FL  ICRUF_RI_NFL  ICRUF_RI_NDC  ICRUF_RF_SL  ICRUF_RF_PR
C--------------------------------------------------------------------------------
     0         6            7             8             9            10
C*******************************************************************************
C                           Initial Soil Moisture Condition 
C                                 For Ponded Lands 
C
C   IE      ;  Element ID (0 if following values are to be used for all elements) 
C   FSOILMP ;  Fraction of initial soil moisture at element IE that is due to precipitation
C   SOILM   ;  Initial root zone moisture content; [L/L]
C               (1 to NRICE + NREFUGE)
C               * List the root zone depths in the same order as the crop 
C                 codes (CCODE) are listed above; first for rice categories, 
C                 then for refuge categories
C               * SOILM can be greater than 1.0 to reflect ponding conditions for 
C                 rice and refuge. When SOILM is greater than 1.0, the ponding  
C                 depth will be computed as RootDepth x (SOILM-1) 
C 
C------------------------------------------------------------------------------------------
C   IE   FSOILMP  SOILM_RI_FL   SOILM_RI_NFL   SOILM_RI_NDC   SOILM_RF_SL    SOILM_RF_PR
