C*******************************************************************************
C                          File Description
C
C   This data file contains the parameters and data file names for the simulation
C   of root zone processes and managament of non-ponded agricultural crops.
C
C*******************************************************************************
C            Number of Non-Ponded Agricultural Crops and Crop Codes
C
C   NCROP    ;  Number of agricultural crops excluding ponded crops (i.e. rice and refuge)
C   FLDMD    ;  Flag for the root zone moisture to be used for the computation of  
C                agricultural water demand and the timing of irrigation
C                * 0: Use the soil moisture at the beginning of time step 
C                * 1: Use the soil moisture at the end of time step
C   CCODE    ;  Crop codes (max. 2 characters)
C                (1 to NCROP)
C   LUFLNP   ;  File that lists the crop areas (max. 1000 characters)
C
C--------------------------------------------------------------------------------
C   VALUE                 DESCRIPTION
C--------------------------------------------------------------------------------
    20                                         / NCROP
    1                                          / FLDMD
    GR                                         / CCODE[ 1]  Grain
    CO                                         / CCODE[ 2]  Cotton
    SB                                         / CCODE[ 3]  Sugar Beets
    CN                                         / CCODE[ 4]  Corn
    DB                                         / CCODE[ 5]  Dry Beans
    SA                                         / CCODE[ 6]  Safflower
    FL                                         / CCODE[ 7]  Other Field
    AL                                         / CCODE[ 8]  Alfalfa
    PA                                         / CCODE[ 9]  Pasture
    TP                                         / CCODE[10]  Tomato-Processing
    TF                                         / CCODE[11]  Tomato-Fresh
    CU                                         / CCODE[12]  Cucurbits
    OG                                         / CCODE[13]  Onions & Garlic
    PO                                         / CCODE[14]  Potatoes
    TR                                         / CCODE[15]  Other Truck
    AP                                         / CCODE[16]  Almonds & Pistachios
    OR                                         / CCODE[17]  Other Deciduous
    CS                                         / CCODE[18]  Citrus & Subtropical
    VI                                         / CCODE[19]  Vineyards
    ID                                         / CCODE[20]  Idle
    RootZone\C2VSimCG_NonPondedCrop_Area.dat   / LUFLNP
C*******************************************************************************
C                      Water Budget Output Files
C
C   NBCROP   ;  Number of non-ponded crops for water budget output
C                * Enter 0 if crop specific budget output is not required
C   BCCODE   ;  Crop codes (from above) for which water budget output is required
C                (1 to NBCROP)
C   CLWUBUDFL;  HDF5 output file for land and water use budget at each 
C                  subregion for selected crops (max. 1000 characters)
C                * Leave blank if this output is not required
C   CRZBUDFL ;  HDF5 output file for root zone moisture budget at each
C                  subregion for selected crops (max. 1000 characters)
C                * Leave blank if this output is not required
C
